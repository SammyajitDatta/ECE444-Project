{
  "name": "applypilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "frontend/app"
  ],
  "scripts": {
    "dev": "concurrently -k -n resume,api,web \"npm run dev -w server\" \"python backend/app.py\" \"npm run dev -w app\"",
    "build": "npm run build -w app",
    "test": "node --test server/tests/*.test.mjs",
    "test:backend": "python -m pytest backend/tests -q"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
